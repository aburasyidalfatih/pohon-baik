DATABASE_URL=postgresql://pohonbaik:pohonbaik@127.0.0.1:5432/pohonbaik
PAYLOAD_SECRET=ganti-dengan-string-acak-panjang
SERVER_URL=http://localhost:3000
# true = materi berstatus 'Perlu ditinjau' tetap tampil (pengembangan/pemakaian pribadi)
CONTENT_INCLUDE_UNREVIEWED=true
# Pembayaran langganan (Midtrans Snap). Kosong saat pengembangan = mode simulasi (/langganan/simulasi).
# Production WAJIB diisi; tanpa kunci, tombol bayar dinonaktifkan.
MIDTRANS_SERVER_KEY=
# true = akun production Midtrans; selain itu sandbox
MIDTRANS_IS_PRODUCTION=false
# Opsional, batasi metode bayar (hemat biaya untuk nominal kecil), mis. other_qris,gopay,shopeepay
MIDTRANS_ENABLED_PAYMENTS=
